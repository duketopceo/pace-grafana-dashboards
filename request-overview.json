{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Relay Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(relay_http_requests_total[5m]))", "legendFormat": "relay" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Target Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "up{job=~\"strut-local|relay-local|pace-agents-local\"}", "legendFormat": "{{job}}" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }], "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.5 }] } } }
    },
    {
      "title": "Core Service Errors (Loki)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "{container_name=~\"pace-strut|pace-relay|pace-agents\"} |= \"error\" or \"ERROR\"", "refId": "A" }
      ],
      "datasource": { "type": "loki", "uid": "loki" }
    },
    {
      "title": "All Targets Up",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "up", "legendFormat": "{{job}}" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    }
  ],
  "schemaVersion": 39,
  "tags": ["pace", "http"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Pace — Request Overview",
  "uid": "pace-request-overview"
}
